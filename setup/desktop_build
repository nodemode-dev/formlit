#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
"$FORMLIT_ROOT/setup/build_frontend"
"$FORMLIT_ROOT/setup/freeze_backend"
cd "$FORMLIT_ROOT"
[ -f src-tauri/icons/icon.icns ] || frontend/node_modules/.bin/tauri icon assets/formlit_icon.png
frontend/node_modules/.bin/tauri build "$@"
fl_say "bundles are in src-tauri/target/release/bundle"
