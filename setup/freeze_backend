#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fl_venv
python -c "import PyInstaller" 2>/dev/null || fl_die "PyInstaller missing, run ./formlit install-desktop"
triple="$(fl_target_triple)" || fl_die "rustc not found; install Rust or set FORMLIT_TARGET"
[ -f "$FORMLIT_ROOT/frontend/dist/index.html" ] || "$FORMLIT_ROOT/setup/build_frontend"
cd "$FORMLIT_ROOT/backend"
sep=":"
[ "$(fl_os)" = windows ] && sep=";"
ext="$(fl_exe)"
if [ "$(fl_os)" = macos ]; then
  gpl="$(python -c 'import pathlib, cv2; print("\n".join(str(p) for p in pathlib.Path(cv2.__file__).parent.rglob("*") if any(k in p.name.lower() for k in ("libx264", "libx265", "librubberband", "libvidstab", "libpostproc"))))' 2>/dev/null | head -1)"
  [ -z "$gpl" ] || fl_die "GPL FFmpeg library in OpenCV: $gpl. Reinstall opencv from source without FFmpeg: PIP_NO_BINARY=opencv-python,opencv-python-headless CMAKE_ARGS=-DWITH_FFMPEG=OFF pip install --force-reinstall -r requirements_macos.txt"
fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean --onefile --name formlit-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller --paths "$FORMLIT_ROOT/backend" \
  --add-data "$FORMLIT_ROOT/frontend/dist${sep}frontend_dist" \
  --add-data "$FORMLIT_ROOT/shared${sep}shared" \
  --hidden-import app.engine.cmd_library --hidden-import app.engine.cmd_develop --hidden-import app.engine.presets --hidden-import app.engine.cmd_ai \
  --hidden-import app.engine.cmd_output --hidden-import app.engine.agents --hidden-import app.engine.cmd_terminal --hidden-import app.engine.claude_code --hidden-import app.engine.cmd_analyze --hidden-import app.engine.preset_library --hidden-import app.engine.cmd_workflow --hidden-import app.engine.cmd_templates --hidden-import app.engine.cmd_chat --hidden-import app.engine.template_library --hidden-import app.output.export_library --hidden-import app.routers.mcp_workflows --hidden-import ptyprocess --hidden-import app.output.services.webdav --hidden-import app.output.services.s3 --collect-submodules uvicorn --collect-all rawpy --collect-all llvmlite --collect-submodules numba --hidden-import cv2 \
  --collect-all reportlab --collect-all onnxruntime --hidden-import tifffile --collect-all imagecodecs \
  --collect-submodules app --collect-submodules paramiko --collect-all pikepdf \
  --exclude-module pillow_heif \
  "$FORMLIT_ROOT/backend/formlit_engine.py"
"dist-engine/formlit-engine${ext}" --selfcheck || fl_die "the frozen engine failed its selfcheck; nothing was copied to src-tauri/binaries"
mkdir -p "$FORMLIT_ROOT/src-tauri/binaries"
out="$FORMLIT_ROOT/src-tauri/binaries/formlit-engine-${triple}${ext}"
cp "dist-engine/formlit-engine${ext}" "$out"
fl_say "sidecar ready: $out"
