#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[formlit] engine venv missing, run ./formlit install" >&2; exit 1; }
# shellcheck disable=SC1091
source venv/bin/activate
exec uvicorn app.main:app --reload --reload-dir app --host "${FORMLIT_HOST:-127.0.0.1}" --port "${FORMLIT_PORT:-8390}"
