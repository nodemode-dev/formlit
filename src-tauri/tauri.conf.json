{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormLit",
  "version": "0.51.3",
  "identifier": "ai.nodemode.formlit",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormLit",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Photo library and raw developer",
    "longDescription": "formlit is a photo library and raw developer in the form family: a catalog with collections, keywords and intelligent collections, non-destructive raw development in a compiled local engine, masking, retouching, and Map, Book, Slideshow, Print and Web output.",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/formlit-engine"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fldb"], "name": "formlit Catalog", "description": "formlit photo catalog", "role": "Editor", "mimeType": "application/x-formlit-catalog" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://dl.formai.studio/formlit/updates/latest.json"]
    }
  }
}
