{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formlit",
  "version": "0.47.2",
  "identifier": "ai.nodemode.formlit",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formlit",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Photo library and raw developer",
    "longDescription": "formlit is a photo library and raw developer in the form family: a catalog with collections, keywords and intelligent collections, non-destructive raw development in a compiled local engine, masking, retouching, and Map, Book, Slideshow, Print and Web output.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formlit-engine"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fldb"], "name": "formlit Catalog", "description": "formlit photo catalog", "role": "Editor", "mimeType": "application/x-formlit-catalog" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formlit-updates/latest.json"]
    }
  }
}
